<section class="counter-up my-5" data-aos="fade-up" data-aos-delay="100">
    <div class="container">
        <div class="row">
            {% for key, value in about.servicesStats %}
                <div class="col-lg-3 col-12 mt-5 mt-lg-0" data-aos="fade-{{ cycle(['right', 'up', 'down', 'left'], loop.index0) }}" data-aos-delay="{{ 200 + (loop.index0 * 50) }}">
                    <i class="ri-discuss-line icon"></i>
                    <h1 class="counter">+{{ value }}</h1>
                    <h2 class="title-2">{{ key|capitalize }}</h2>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
