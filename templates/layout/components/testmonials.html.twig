<section class="container testimonials py-5">
    <div class="heading">
        <h4 class="pretitle" data-aos="fade-up">
            testimonials
        </h4>
        <h1 class="title col-12" data-aos="fade-up" data-aos-delay="100">
            Customers Testmonials
        </h1>
        <p class="col-lg-7 col-12" data-aos="fade-up" data-aos-delay="150">
            As a matter of fact the unification of the coherent software provides a strict control over
            The Accomplishment of Intended Estimation
        </p>
    </div>
    <div class="row" data-aos="fade-up" data-aos-delay="200">
        <div class="owl-carousel testimonial owl-theme">

            {% for item in testmonials %}
            <div class="item">
                <div class="box">
                    <div class="d-flex justify-content-center align-items-center m-2">
                        <div class="col-2 ms-4 ">
                            <img class="rounded-circle" src="{{ asset('template/images/testimonials/testimonials-1.jpg') }}" alt="testimonial-img">
                        </div>
                        <div class="col-10 d-flex flex-column mx-4">
                            <h1 class="title-2">
                                {{ item.name }}
                            </h1>
                            <div class="justify-content-between">
                                {% for i in 1..5  %}
                                    {% if item.score  >= i %}
                                        <i class="bi bi-star-fill"></i>
                                    {% elseif item.score > i - 1 %}
                                        <i class="bi bi-star-half"></i>
                                    {% else %}
                                        <i class="bi bi-star"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>

                        </div>
                    </div>
                    <p> {{ item.content }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
