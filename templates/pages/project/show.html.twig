{% extends 'base.html.twig' %}

{% block body %}
    <div class="single-service">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-lg-8 col-12" data-aos="fade-right" data-aos-delay="150">
                    <img
                            {% if   project.getFirstProjectFile()  is not null %}
                                src="{{ vich_uploader_asset(project.getFirstProjectFile(),'thumbnailFile') }}"
                                alt="{{  project.getFirstProjectFile().name }}"
                            {% else %}
                                src="{{ asset('template/images/service/banner-img2.png') }}"
                            {% endif %}
                         alt="service-img">

                    <h2 class="title my-2">{{ project.title }}</h2>
                    <p>{{ project.fullDescription }}</p>
                    <img src="{{ asset('template/images/service/business-development-2885464-2409431.webp') }}" alt="service-img">
                    <div class="project-results row g-2 my-4">
                        <h2 class="title my-2">Project results</h2>
                        {% for projectFile in project.getRemainingProjectFiles() %}
                        <div class="col-lg-6 col-12">
                            <img src="{{ vich_uploader_asset(projectFile,'thumbnailFile') }}" alt="{{ projectFile.name }}">
                        </div>
                            {% else %}
                            <div class="col-lg-6 col-12"><span class="">No images</span></div>
                        {% endfor %}
                    </div>

                </div>
                <div class="col-lg-3 col-sm-12 client-side row g-2" data-aos="fade-left" data-aos-delay="150">
                    <div class="col-12">
                        <div class="box row align-items-center justify-content-center">
                            <div class="icon">
                                <i class="bi bi-person-lines-fill"></i>
                            </div>
                            <div class="text">
                                <h2 class="title-2 m-0">client</h2>
                                <h3>ahmad erramix</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="box row align-items-center justify-content-center">
                            <div class="icon">
                                <i class="bi bi-list-check"></i>
                            </div>
                            <div class="text">
                                <h2 class="title-2 m-0">service</h2>
                                <h3>digital marketing</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="box row align-items-center justify-content-center">
                            <div class="icon">
                                <i class="bi bi-calendar2-check-fill"></i>
                            </div>
                            <div class="text">
                                <h2 class="title-2 m-0">date</h2>
                                <h3>10/04/2023</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="box row align-items-center justify-content-center">
                            <div class="icon">
                                <i class="bi bi-stopwatch-fill"></i>
                            </div>
                            <div class="text">
                                <h2 class="title-2 m-0">duration</h2>
                                <h3>4 days</h3>
                            </div>
                        </div>
                    </div>
                    <h2 class="title-2 mt-4">follow us</h2>
                    {% include "layout/components/social_section.html.twig" with {'link':link} %}

                </div>
            </div>

