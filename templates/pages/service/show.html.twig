{% extends 'base.html.twig' %}

{% block body %}
	{% set currentDescription =getServiceDescription(app.request.locale,service) %}
	<div class="single-service">
		<div class="container">
			<div class="row justify-content-between">
				<div class="col-lg-7 col-12" data-aos="fade-right" data-aos-delay="200">
					<img src="{{ asset('uploads/images/service/top_end_images/' ~ currentDescription.getTopImage()) }}" alt="service-img">
					<h2 class="title my-2">
						{{ currentDescription.title }}</h2>
					<div class="">
						{{ currentDescription.content }}
					</div>
					<img src="{{ asset('uploads/images/service/top_end_images/' ~ currentDescription.getEndImage()) }}" alt="service-img">
					<h2 class="title my-2">Information about Services We Offer</h2>
					<p>{{ currentDescription.reasonTochooseIntro }}</p>
					<div class="project-steps row g-2 my-4">
						{% for reason in currentDescription.reasons %}
							<div class="col-lg-6 col-12 mx-auto ">
								<div class="box box-service ">
									<h3 class="title-2 my-2 ">
										<span class="unique-text">{{ loop.index }}.
										</span>
										{{ reason.title }}</h3>
									<p>{{ reason.description }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
				<div class="col-lg-4 service-side row g-2" data-aos="fade-left" data-aos-delay="200">
					<h2 class="title-2">list of services</h2>
					{% include 'layout/components/service_list.html.twig' with {'services': services, 'with_link': false} %}
					<h2 class="title-2 mt-4">follow us</h2>
					{% include "layout/components/social_section.html.twig" with {'link':link} %}
				</div>
			</div>

			{% include "layout/partials/_faq.html.twig" %}

		</div>
	</div>
{% endblock %}

{% block title %}{% endblock %}
